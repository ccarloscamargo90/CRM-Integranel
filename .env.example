# =====================================================================
# CRM-Granos-MX — Variables de entorno (PLANTILLA)
# =====================================================================
# Copia este archivo a `.env` y rellena cada valor.
# `.env` está en `.gitignore` y NUNCA debe subirse al repositorio.
# Ningún valor real va aquí — sólo placeholders descriptivos.
# =====================================================================

# ---------- Entorno ----------
APP_NAME=CRM-Granos-MX
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------- Base de datos ----------
# Local (Postgres.app, default puerto 5432, usuario = tu usuario macOS)
# Para producción Render: la URL completa la entrega Render como variable.
DATABASE_URL=postgresql+psycopg://carlosacamargo@localhost:5432/crm_granos_mx
DATABASE_ECHO=false              # true para imprimir queries SQL en logs

# ---------- INEGI / DENUE ----------
# Token gratis: https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx
INEGI_DENUE_TOKEN=tu_token_de_inegi_aqui

# ---------- Google Cloud / Places API ----------
GOOGLE_PLACES_API_KEY=tu_api_key_de_google_aqui
MONTHLY_BUDGET_USD=100           # circuit breaker — pausa si gasto mensual lo excede

# ---------- Auth & seguridad ----------
SECRET_KEY=cambiar_por_random_64_chars
JWT_SECRET_KEY=cambiar_por_random_64_chars_distinto_del_anterior
JWT_EXPIRE_MINUTES=480           # 8 horas
RECOVERY_MASTER_KEY=cambiar_por_clave_maestra_solo_admin

# ---------- SMTP (recovery por email) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo_corporativo@intergranel.mx
SMTP_PASS=app_password_de_gmail
SMTP_FROM=CRM Granos <correo_corporativo@intergranel.mx>

# ---------- API interna (handoff a comercial-app v2 cuando exista) ----------
INTERNAL_TOKEN=cambiar_por_random_64_chars_para_handoff
COMERCIAL_V2_URL=               # URL del sistema comercial nuevo (cuando exista)

# ---------- CORS (cuando se construya el frontend separado) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
