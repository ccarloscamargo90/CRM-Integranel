# CRM Granos MX — Variables de entorno para producción EC2
# Copiar a /home/ec2-user/ERP-INTERGRANEL/.env.crm y rellenar valores reales

# ---------- Entorno ----------
APP_NAME=CRM-Granos-MX
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- Base de datos ----------
DATABASE_URL=postgresql+psycopg://crm:CAMBIAR_PASSWORD@crm-postgres:5432/crm_granos_mx
DATABASE_ECHO=false

# ---------- Auth & seguridad (generar con: openssl rand -base64 48) ----------
SECRET_KEY=CAMBIAR_POR_64_CHARS_RANDOM
JWT_SECRET_KEY=CAMBIAR_POR_64_CHARS_RANDOM_DISTINTO
JWT_EXPIRE_MINUTES=480
RECOVERY_MASTER_KEY=CAMBIAR_POR_CLAVE_MAESTRA

# ---------- Admin inicial ----------
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# ---------- INEGI / DENUE ----------
INEGI_DENUE_TOKEN=CAMBIAR_TOKEN_INEGI

# ---------- Google Places ----------
GOOGLE_PLACES_API_KEY=CAMBIAR_API_KEY_GOOGLE
MONTHLY_BUDGET_USD=100

# ---------- DB interna (usada por docker-compose.crm.yml) ----------
CRM_DB_USER=crm
CRM_DB_PASSWORD=CAMBIAR_PASSWORD_DB
CRM_DB_NAME=crm_granos_mx

# ---------- CORS ----------
CORS_ORIGINS=https://crm.intergranel.com
